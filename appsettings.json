{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "Enabled": true,
    "WindowSeconds": 60,
    "GlobalPerWindow": 300,
    "WikipediaImportPerWindow": 10,
    "SearchLogPerWindow": 30,
    "AdminCheckPerWindow": 10
  }
}
