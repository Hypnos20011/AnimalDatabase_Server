DOMAIN=203-0-113-10.sslip.io
OLD_DOMAIN=

MARIADB_ROOT_PASSWORD=change-me-root-password
MARIADB_DATABASE=animaldatabase
APP_DB_USER=animaldb_app
APP_DB_PASSWORD=change-me-app-password

ADMIN_API_KEY=change-me-admin-key
TESTER_API_KEY=

UI_SOURCE=../../AnimalDatabase_UI

BACKUP_TIME_UTC=01:30
BACKUP_KEEP_DAYS=14
BACKUP_HOST_DIR=../../backups

DEEPL_API_KEY=change-me-deepl-key

# LibreTranslate is an optional DeepL fallback (compose service libretranslate).
# When LIBRETRANSLATE_BASE_URL is unset, compose defaults to http://libretranslate:5000/
# (Docker network only; not published on the host). Set it empty to disable fallback.
# Leave ApiKey empty unless you enable LT_API_KEYS on the libretranslate service.
# The container loads only en,de and is RAM-heavy (~768 MiB cap); disable if the host is tight.
# LIBRETRANSLATE_BASE_URL=
# LIBRETRANSLATE_API_KEY=
